+static String batchJsonStr(const String& in) {
+  String out="\"";
+  for (unsigned char c: in) {
+    if (c=='"' || c=='\\') {
+      out+='\\';
+      out+=(char)c;
+    } else if (c<0x20) {
+      out+=fmt::sprintf("\\u%.4x",(int)c);
+    } else {
+      out+=(char)c;
+    }
+  }
+  out+="\"";
+  return out;
+}
+
+static bool batchWriteFile(const String& path, const String& data) {
+  FILE* f=ps_fopen(path.c_str(),"wb");
+  if (f==NULL) {
+    logE("could not open %s for writing: %s",path,strerror(errno));
+    return false;
+  }
+  fwrite(data.c_str(),1,data.size(),f);
+  fclose(f);
+  return true;
+}
